<mxCell id="d4_saran_beli" value="Generate &lt;b&gt;Saran Pembelian&lt;/b&gt; (Pusat):&lt;br/&gt;&amp;bull; Target: Pesan ke Supplier&lt;br/&gt;&amp;bull; Insert &lt;i&gt;saran_pembelian&lt;/i&gt;&lt;br/&gt;&amp;bull; Estimasi biaya = Qty &amp;times; Harga Beli" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=10;fontColor=#000000;shadow=0;" vertex="1" parent="1">
