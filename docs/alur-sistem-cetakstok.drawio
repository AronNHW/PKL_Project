  <diagram id="diag_prediksi" name="4. Alur Prediksi Stok & ROP">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="header_title" value="&lt;b style=&quot;font-size:15px;letter-spacing:0.5px;&quot;&gt;DETAIL ALUR PREDIKSI KEBUTUHAN STOK &amp; REORDER POINT (ROP)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#E5E7EB;&quot;&gt;Metode Single Exponential Smoothing (&amp;alpha;=0.20), Safety Stock (Z=1.65), dan Rekomendasi Pengadaan&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontFamily=IBM Plex Sans, Arial, sans-serif;fontColor=#FFFFFF;align=center;shadow=0;" vertex="1" parent="1">
  <mxGeometry x="40" y="20" width="1420" height="50" as="geometry" />
</mxCell>
<mxCell id="d4_start" value="Mulai: Trigger Rutin Bulanan (Laravel Scheduler)&lt;br/&gt;&lt;i&gt;php artisan stok:hitung-prediksi&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=2;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=11;fontStyle=1;fontColor=#FFFFFF;shadow=0;" vertex="1" parent="1">
  <mxGeometry x="570" y="100" width="280" height="55" as="geometry" />
</mxCell>
<mxCell id="d4_query_historis" value="Query Data Historis Pemakaian:&lt;br/&gt;Tabel &lt;b&gt;pemakaian_bulanan&lt;/b&gt; per Bahan &amp;amp; Lokasi" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=10;fontColor=#000000;shadow=0;" vertex="1" parent="1">
  <mxGeometry x="580" y="185" width="260" height="55" as="geometry" />
</mxCell>
<mxCell id="d4_loop" value="Looping Setiap Kombinasi Bahan Baku &amp;amp; Lokasi&lt;br/&gt;&lt;i&gt;(Gudang Pusat + 5 Cabang)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=10;fontColor=#000000;shadow=0;" vertex="1" parent="1">
  <mxGeometry x="580" y="270" width="260" height="50" as="geometry" />
</mxCell>
<mxCell id="d4_ambil_param" value="Ambil Parameter Bahan dari &lt;i&gt;parameter_bahan&lt;/i&gt;:&lt;br/&gt;&amp;bull; &lt;i&gt;lead_time_hari&lt;/i&gt; (default: 3 hari)&lt;br/&gt;&amp;bull; &lt;i&gt;safety_factor&lt;/i&gt; (Z = 1.65 untuk 95% service level)&lt;br/&gt;&amp;bull; Smoothing Constant (&amp;alpha; = 0.20)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=10;fontColor=#000000;shadow=0;" vertex="1" parent="1">
  <mxGeometry x="570" y="350" width="280" height="75" as="geometry" />
</mxCell>
<mxCell id="d4_hitung_ses" value="&lt;b&gt;Hitung Prediksi Pemakaian (SES)&lt;/b&gt;:&lt;br/&gt;&lt;b&gt;F&lt;sub&gt;t+1&lt;/sub&gt; = &amp;alpha; &amp;middot; A&lt;sub&gt;t&lt;/sub&gt; + (1 - &amp;alpha;) &amp;middot; F&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Simpan hasil ke tabel &#39;prediksi&#39;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#000000;strokeWidth=2;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=10;fontColor=#000000;shadow=0;" vertex="1" parent="1">
  <mxGeometry x="570" y="455" width="280" height="75" as="geometry" />
</mxCell>
<mxCell id="d4_hitung_rop" value="&lt;b&gt;Hitung Safety Stock &amp;amp; Reorder Point (ROP)&lt;/b&gt;:&lt;br/&gt;&amp;bull; Rata-rata harian: &lt;i&gt;d = F&lt;sub&gt;t+1&lt;/sub&gt; / 30&lt;/i&gt;&lt;br/&gt;&amp;bull; &lt;i&gt;Safety Stock (SS) = Z &amp;times; &amp;radic;L &amp;times; &amp;sigma;&lt;/i&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;ROP = (d &amp;times; Lead Time) + SS&lt;/b&gt;&lt;br/&gt;Update &lt;i&gt;parameter_bahan&lt;/i&gt; (&lt;i&gt;rop, safety_stock&lt;/i&gt;)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#000000;strokeWidth=2;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=10;fontColor=#000000;shadow=0;" vertex="1" parent="1">
  <mxGeometry x="560" y="560" width="300" height="90" as="geometry" />
</mxCell>
<mxCell id="d4_cek_stok" value="Bandingkan Stok Aktual Saat Ini:&lt;br/&gt;&lt;b&gt;stok_lokasi.jumlah &amp;le; ROP?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=10;fontStyle=1;fontColor=#000000;shadow=0;" vertex="1" parent="1">
  <mxGeometry x="600" y="680" width="220" height="70" as="geometry" />
</mxCell>
<mxCell id="d4_status_aman" value="Status Stok: &lt;b&gt;Aman&lt;/b&gt;&lt;br/&gt;&amp;bull; Tidak perlu pengadaan segera&lt;br/&gt;&amp;bull; Indikator status normal di tabel" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=10;fontColor=#000000;shadow=0;" vertex="1" parent="1">
  <mxGeometry x="950" y="685" width="230" height="60" as="geometry" />
</mxCell>
<mxCell id="d4_status_kritis" value="Status Stok: &lt;b&gt;Menipis / Kritis&lt;/b&gt;&lt;br/&gt;Stok berada di bawah ambang batas aman" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E4E4E7;strokeColor=#000000;strokeWidth=1.5;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=10;fontStyle=1;fontColor=#000000;shadow=0;" vertex="1" parent="1">
  <mxGeometry x="600" y="790" width="220" height="55" as="geometry" />
</mxCell>
<mxCell id="d4_cek_tipe_lokasi" value="Cek Tipe Lokasi:&lt;br/&gt;&lt;b&gt;Gudang Pusat ATAU Cabang?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=10;fontStyle=1;fontColor=#000000;shadow=0;" vertex="1" parent="1">
