<mxCell id="d4_saran_dist" value="Generate &lt;b&gt;Saran Distribusi&lt;/b&gt; (Cabang):&lt;br/&gt;&amp;bull; Target: Kirim dari Gudang Pusat&lt;br/&gt;&amp;bull; Insert &lt;i&gt;saran_distribusi&lt;/i&gt;&lt;br/&gt;&amp;bull; Qty saran = ROP &amp;times; 2 - Stok Saat Ini" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=10;fontColor=#000000;shadow=0;" vertex="1" parent="1">
