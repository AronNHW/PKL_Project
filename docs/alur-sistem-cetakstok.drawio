<mxCell id="header_title" value="&lt;b style=&quot;font-size:15px;letter-spacing:0.5px;&quot;&gt;DETAIL ALUR KERUSAKAN MESIN &amp; PENGGANTIAN SUKU CADANG&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#E5E7EB;&quot;&gt;Integrasi Modul Pemeliharaan Mesin dengan Stok Suku Cadang (Kategori: Suku Cadang)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontFamily=IBM Plex Sans, Arial, sans-serif;fontColor=#FFFFFF;align=center;shadow=0;" vertex="1" parent="1">
  <mxGeometry x="40" y="20" width="1420" height="50" as="geometry" />
</mxCell>
<mxCell id="d3_start" value="Mulai: Kendala / Kerusakan Mesin di Cabang" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=2;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=11;fontStyle=1;fontColor=#FFFFFF;shadow=0;" vertex="1" parent="1">
  <mxGeometry x="590" y="100" width="260" height="50" as="geometry" />
</mxCell>
<mxCell id="d3_akses_form" value="Admin Cabang Akses Modul Mesin &amp;rarr; &lt;b&gt;Lapor Kerusakan&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Mobile Friendly / Akses Cepat HP Kamera)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=10;fontColor=#000000;shadow=0;" vertex="1" parent="1">
  <mxGeometry x="590" y="180" width="260" height="60" as="geometry" />
</mxCell>
<mxCell id="d3_input_lapor" value="Isi Form Laporan Kerusakan:&lt;br/&gt;&amp;bull; Pilih Mesin Percetakan (&lt;i&gt;id_mesin&lt;/i&gt;)&lt;br/&gt;&amp;bull; Gejala Kerusakan&lt;br/&gt;&amp;bull; Kronologi Kejadian&lt;br/&gt;&amp;bull; Foto Kerusakan (Upload HP/Kamera Langsung)&lt;br/&gt;&amp;bull; Perkiraan Suku Cadang (&lt;i&gt;detail_kerusakan&lt;/i&gt;)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=10;fontColor=#000000;shadow=0;" vertex="1" parent="1">
  <mxGeometry x="590" y="275" width="260" height="95" as="geometry" />
</mxCell>
<mxCell id="d3_submit_lapor" value="Submit Laporan ke Sistem:&lt;br/&gt;&amp;bull; Insert &lt;i&gt;laporan_kerusakan&lt;/i&gt; (status: &lt;b&gt;dilaporkan&lt;/b&gt;)&lt;br/&gt;&amp;bull; Update status mesin &amp;rarr; &lt;b&gt;rusak&lt;/b&gt;&lt;br/&gt;&amp;bull; Simpan path foto ke disk &lt;i&gt;public&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#000000;strokeWidth=2;fontFamily=IBM Plex Sans, Arial, sans-serif;fontSize=10;fontColor=#000000;shadow=0;" vertex="1" parent="1">
  <mxGeometry x="590" y="400" width="260" height="75" as="geometry" />
</mxCell>
